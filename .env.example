# Any OpenAI-compatible chat-completions endpoint. Copy to .env and fill in.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Required: the model name your provider expects.
LLM_MODEL=
# Ask the provider for JSON output (response_format=json_object). Set to false if it is not supported.
LLM_JSON_MODE=true
LLM_TEMPERATURE=0
# One JSON line per LLM call, used for the audit trail and AI-use declaration.
LLM_CALL_LOG=governance/llm_call_log.jsonl
