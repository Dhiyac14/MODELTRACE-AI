  "sections": [
    {
      "key": "overview",
      "title": "Model overview and intended purpose",
      "status": "available",
      "source": "llm_draft",
      "text": "Legacy R Logistic Regression (model_id legacy-r-logistic, risk tier 1) estimates the probability that a credit-card customer defaults next month and is described as being used in credit decisions; the model name and business purpose are inferred rather than formally documented. It is trained on the UCI Default of Credit Card Clients dataset (30,000 records, Taiwan, April to September 2005), which is designated as public demonstration data only and is not representative of a UK bank's current portfolio. The formal model name, version, owner, intended users, decision context and approval status are not documented.",
      "rows": []
    },
