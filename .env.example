# Copy to .env and fill in LLM_API_KEY. .env is git-ignored; never commit a key.

# Backend: anthropic (Claude through the native Anthropic SDK) or openai (any OpenAI-compatible endpoint).
LLM_PROVIDER=anthropic
LLM_API_KEY=
# anthropic: defaults to claude-opus-5-5. openai: required, the model name your provider expects.
LLM_MODEL=claude-opus-5-5
# anthropic only: low | medium | high | xhigh | max
LLM_EFFORT=medium
# anthropic only: server-side refusal fallback ("default") or "off"
LLM_FALLBACKS=default
# Empty means the provider default (Claude: https://api.anthropic.com; openai: https://api.openai.com/v1)
LLM_BASE_URL=
# openai only: ask for JSON output (set false if the provider rejects response_format) and sampling temperature
LLM_JSON_MODE=true
LLM_TEMPERATURE=0
# One JSON line per LLM call, used for the audit trail and AI-use declaration.
LLM_CALL_LOG=governance/llm_call_log.jsonl
